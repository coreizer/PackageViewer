<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackageViewer.Views.MessageDialog"
        Icon="/Assets/appicon.ico"
        Title="PS3 Package Viewer"
        Width="440"
        SizeToContent="Height"
        MinHeight="150"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="okButton" Content="OK" MinWidth="80" IsDefault="True" IsCancel="True" Click="OkButton_Click" />
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*">
      <Image x:Name="iconImage" Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,14,0" />

      <StackPanel Grid.Column="1" Spacing="8">
        <TextBlock x:Name="headingText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="messageText" TextWrapping="Wrap" />
        <Expander x:Name="detailsExpander" Header="Show details" IsVisible="False" Margin="0,4,0,0">
          <TextBox x:Name="detailsText"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono, Consolas, monospace"
                   FontSize="11"
                   MaxHeight="220"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Expander>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
