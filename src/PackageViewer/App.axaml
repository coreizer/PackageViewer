<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PackageViewer.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- Menu bar icons -->
    <Style Selector="Image.menuIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Image.listIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Status bar -->
    <Style Selector="Border.statusBar">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.statusBar TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Compact list rows -->
    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Styles>
</Application>
